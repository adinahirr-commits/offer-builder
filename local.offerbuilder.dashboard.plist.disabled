<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.offerbuilder.dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/adisomech/offer-builder/server.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/adisomech/offer-builder</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>4900</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/adisomech/offer-builder/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/adisomech/offer-builder/server.log</string>
</dict>
</plist>
